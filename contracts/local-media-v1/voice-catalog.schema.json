{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/contracts/local-media-v1/voice-catalog.schema.json",
  "title": "OpenClaw local TTS voice catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_voice", "voices"],
  "properties": {
    "schema_version": { "const": 1 },
    "default_voice": { "$ref": "#/$defs/voiceId" },
    "voices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/voice" }
    }
  },
  "$defs": {
    "voiceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "reference_path"],
      "properties": {
        "id": { "$ref": "#/$defs/voiceId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reference_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "locale": { "type": "string", "minLength": 1, "maxLength": 32 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exaggeration": { "type": "number", "minimum": 0, "maximum": 2 },
            "temperature": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
            "cfg_weight": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    }
  }
}
