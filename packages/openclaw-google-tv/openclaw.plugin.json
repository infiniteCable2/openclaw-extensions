{
  "id": "google-tv",
  "name": "Google TV",
  "description": "Bounded Remote v2 control with optional paired ADB observation.",
  "version": "0.1.0",
  "activation": {
    "onStartup": false,
    "onConfigPaths": [
      "plugins.entries.google-tv.config"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "allowedAgentIds",
      "pythonPath",
      "devices"
    ],
    "properties": {
      "allowedAgentIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
      },
      "pythonPath": {
        "type": "string",
        "minLength": 1
      },
      "recipeDirectory": {
        "type": "string",
        "minLength": 1
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 15000
      },
      "powerOnTimeoutMs": {
        "type": "integer",
        "minimum": 12000,
        "maximum": 45000,
        "default": 30000
      },
      "screenshotDirectory": {
        "type": "string",
        "minLength": 1
      },
      "screenshotMaxAgeSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400,
        "default": 900
      },
      "devices": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "host",
            "remoteCertPath",
            "remoteKeyPath"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "host": {
              "type": "string",
              "format": "ipv4"
            },
            "remoteCertPath": {
              "type": "string",
              "minLength": 1
            },
            "remoteKeyPath": {
              "type": "string",
              "minLength": 1
            },
            "wake": {
              "type": "object",
              "additionalProperties": false,
              "required": ["macAddress", "broadcastAddress"],
              "properties": {
                "macAddress": { "type": "string", "pattern": "^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$" },
                "broadcastAddress": { "type": "string", "format": "ipv4" }
              }
            },
            "adb": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "home",
                "serial"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "home": {
                  "type": "string",
                  "minLength": 1
                },
                "serial": {
                  "type": "string",
                  "minLength": 1
                },
                "serverPort": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535,
                  "default": 5038
                }
              }
            },
            "apps": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "via",
                  "locator"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "via": {
                    "type": "string",
                    "enum": [
                      "remote",
                      "adb"
                    ]
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "google_tv_status",
      "google_tv_control",
      "google_tv_observe",
      "google_tv_guide"
    ]
  },
  "toolMetadata": {
    "google_tv_status": {
      "optional": true,
      "replaySafe": true,
      "sideEffecting": false
    },
    "google_tv_control": {
      "optional": true,
      "replaySafe": false,
      "sideEffecting": true
    },
    "google_tv_observe": {
      "optional": true,
      "replaySafe": true,
      "sideEffecting": false
    },
    "google_tv_guide": {
      "optional": true,
      "replaySafe": true,
      "sideEffecting": false
    }
  }
}
