{
  "id": "govee",
  "name": "Govee",
  "description": "Bounded Govee LAN light control.",
  "version": "0.1.0",
  "activation": {
    "onStartup": false,
    "onConfigPaths": [
      "plugins.entries.govee.config",
      "plugins.entries.device-management.config"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "devices"
    ],
    "properties": {
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 500,
        "maximum": 15000,
        "default": 5000
      },
      "devices": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "address"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "address": {
              "type": "string",
              "format": "ipv4"
            }
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "govee_status",
      "govee_control"
    ]
  },
  "toolMetadata": {
    "govee_status": {
      "optional": true,
      "replaySafe": true,
      "sideEffecting": false
    },
    "govee_control": {
      "optional": true,
      "replaySafe": false,
      "sideEffecting": true
    }
  }
}
