{
  "id": "device-management",
  "name": "Device Management",
  "description": "Agent-scoped inventory of managed devices, sites and available device tools.",
  "version": "0.1.0",
  "activation": {
    "onStartup": false,
    "onConfigPaths": [
      "plugins.entries.device-management.config"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "providers",
      "devices"
    ],
    "properties": {
      "providers": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 32,
        "propertyNames": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "description": "Provider ID to absolute immutable plugin package directory. The package supplies device-provider.json and its OpenClaw manifest."
      },
      "devices": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "kind",
            "siteId",
            "room",
            "provider",
            "grants"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "type": "string",
              "enum": [
                "light",
                "switch",
                "media_receiver",
                "television",
                "computer"
              ]
            },
            "siteId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "room": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "provider": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "grants": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "read",
                    "control",
                    "observe",
                    "guide"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "device_inventory"
    ]
  },
  "toolMetadata": {
    "device_inventory": {
      "optional": true,
      "replaySafe": true,
      "sideEffecting": false,
      "configSignals": [
        {
          "rootPath": "plugins.entries.device-management.config",
          "required": [
            "devices"
          ]
        }
      ]
    }
  }
}
